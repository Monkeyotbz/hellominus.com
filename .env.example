# Copia este archivo como `.env` y completa los valores reales.
# Sin estos valores el sitio sigue funcionando con respaldos seguros
# (formulario vía mailto prellenado, sin botón de WhatsApp, sin analítica).

# --- Contacto ---
VITE_CONTACT_EMAIL=contacto@hellominus.com

# Número de WhatsApp en formato internacional, sin "+" ni espacios.
# Ej. Colombia: 573001234567. Si está vacío no se muestra ningún botón de WhatsApp.
VITE_WHATSAPP_NUMBER=

# URL pública de tu evento de Calendly (ej: https://calendly.com/hellominus/demo-30min)
VITE_CALENDLY_URL=

# Endpoint del formulario. Crea uno gratis en https://formspree.io
# (ej: https://formspree.io/f/xxxxxxxx). Si está vacío, el formulario
# abre el cliente de correo con el mensaje ya redactado.
VITE_FORM_ENDPOINT=

# --- Analítica (solo se carga si el visitante ACEPTA el banner de cookies) ---
# Microsoft Clarity (heatmaps + grabación de sesión, gratis): https://clarity.microsoft.com
VITE_CLARITY_ID=

# Google Analytics 4 (ej: G-XXXXXXXXXX)
VITE_GA_ID=

# --- Chat de ventas con IA (api/chat.js) ---
# Estas son server-only: NUNCA llevan el prefijo VITE_ (no deben llegar al bundle
# del navegador). Se configuran en el dashboard de Vercel (Project Settings →
# Environment Variables), no en el .env que usa Vite.

# Clave de la API de Anthropic. Sin esto el chat responde con un mensaje de
# error amigable y el sitio sigue funcionando igual.
ANTHROPIC_API_KEY=sk-ant-...

# Proyecto Supabase DEDICADO a Hellominus como negocio (no el de KAIROS que usa
# agents/linkedin-agent). Ver supabase/README.md para crearlo y correr el SQL.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key (solo en el servidor, nunca en el frontend)

# Copia server-side de VITE_FORM_ENDPOINT de arriba (mismo valor de Formspree),
# para que el chat notifique por correo igual que el formulario de contacto.
FORM_ENDPOINT=

# Kill-switch opcional: poné "false" para ocultar el widget del chat sin tocar
# código (ej. si hay que pausarlo por costo). Por defecto está visible.
VITE_CHAT_ENABLED=true
