# Copia este archivo como .env y complétalo. .env no se sube al repositorio.
#
# Las variables de la sección "Sitio" se declaran también en Vercel
# (Settings > Environment Variables) marcando Production y Preview. Vite las
# copia dentro del JavaScript al compilar: si cambias una en Vercel, hay que
# volver a desplegar para que el sitio la vea.

# --- Sitio (local y Vercel) -------------------------------------------------

# Supabase de la plataforma (cuentas, reservas, catálogo, blog)
# Credenciales en: https://supabase.com/dashboard > Settings > API Keys
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Contacto de la plataforma. Vacío es válido: la UI esconde el canal
# en lugar de generar un enlace sin destinatario.
VITE_WHATSAPP_NUMBER=
VITE_CONTACT_EMAIL=contacto@hellominus.com

# Dominio público para canonical, Open Graph y sitemap.xml. Lo usa
# scripts/prerender-blog.mjs al compilar. Debe ser el dominio principal
# del proyecto en Vercel (el que no redirige a otro).
SITE_URL=https://hellominus.com

# --- Agentes del blog, agentes-sdk/blog (solo local) -----------------------

# Solo para la corrida real, que cuesta dinero. Python no lee este archivo:
# se exporta en la terminal antes de correr flujo.py.
# ANTHROPIC_API_KEY=
# Topes opcionales; los valores por defecto están en agentes-sdk/blog/config.py.
# HM_TOPE_ARTICULO_USD=1.00

# Las claves privadas (service_role, conexión directa a Postgres) existen solo
# en la máquina de quien aplica migraciones. Nunca en Vercel ni con prefijo
# VITE_: todo lo que empieza con VITE_ termina en el navegador.

# Mercado Pago (próximamente)
# VITE_MERCADOPAGO_PUBLIC_KEY=tu-public-key-aqui

# Resend para emails (próximamente)
# RESEND_API_KEY=tu-resend-api-key-aqui
