# Copia este archivo como `.env` y completa los valores reales.
# Sin estos valores el sitio sigue funcionando con respaldos seguros
# (formulario vía mailto prellenado, sin botón de WhatsApp, sin analítica).

# --- Contacto ---
VITE_CONTACT_EMAIL=contacto@hellominus.com

# Número de WhatsApp en formato internacional, sin "+" ni espacios.
# Ej. Colombia: 573001234567. Si está vacío no se muestra ningún botón de WhatsApp.
VITE_WHATSAPP_NUMBER=

# URL pública de tu evento de Calendly (ej: https://calendly.com/hellominus/demo-30min)
VITE_CALENDLY_URL=

# Endpoint del formulario. Crea uno gratis en https://formspree.io
# (ej: https://formspree.io/f/xxxxxxxx). Si está vacío, el formulario
# abre el cliente de correo con el mensaje ya redactado.
VITE_FORM_ENDPOINT=

# --- Analítica (solo se carga si el visitante ACEPTA el banner de cookies) ---
# Microsoft Clarity (heatmaps + grabación de sesión, gratis): https://clarity.microsoft.com
VITE_CLARITY_ID=

# Google Analytics 4 (ej: G-XXXXXXXXXX)
VITE_GA_ID=
